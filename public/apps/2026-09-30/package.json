{
  "name": "app-invasion-finale",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run validate:data && tsc --noEmit && vite build && node scripts/publish-build.mjs",
    "test": "tsx --test client/src/*.test.ts scripts/lib/*.test.ts",
